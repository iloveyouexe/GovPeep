{
  "name": "govpeep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run build:web && bun run build:api",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck",
    "lint": "bun run --cwd apps/web lint",
    "test": "bun run --cwd apps/api test",
    "test:e2e": "playwright test",
    "db:setup": "bun run --cwd apps/api db:setup",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "cf-typegen": "bun run --cwd apps/api cf-typegen"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "9.2.1"
  }
}
