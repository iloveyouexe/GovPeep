{
	"name": "@govpeep/api",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --local --ip 127.0.0.1 --inspector-port 0",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typecheck": "bun run cf-typegen && tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types",
		"db:migrate": "wrangler d1 migrations apply govpeep-db --local",
		"db:seed": "bun scripts/seed.mjs",
		"db:setup": "bun run db:migrate && bun run db:seed",
		"data:refresh": "bun scripts/snapshot.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.12.7",
		"typescript": "5.9.3",
		"vitest": "3.2.4",
		"wrangler": "4.61.0"
	}
}
