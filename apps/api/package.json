{
	"name": "@govpeep/api",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "bun scripts/dev.mjs",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typecheck": "bun run cf-typegen && tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types",
		"db:migrate": "wrangler d1 migrations apply govpeep-db --local",
		"db:seed": "bun scripts/seed.mjs",
		"db:setup": "bun run db:migrate && bun run db:seed",
		"data:refresh": "bun scripts/snapshot.mjs",
		"data:audit": "bun scripts/audit-assets.mjs"
	},
	"dependencies": {
		"@govpeep/contracts": "workspace:*",
		"better-auth": "1.7.7",
		"@better-auth/drizzle-adapter": "1.7.7",
		"drizzle-orm": "0.45.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.3.6",
		"typescript": "5.9.3",
		"vitest": "4.1.11",
		"wrangler": "4.147.0"
	}
}
